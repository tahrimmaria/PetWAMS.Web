@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login — PetHope</title>

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #f8f5fb;
            }

            .login-box {
                width: 400px;
                background: white;
                padding: 40px;
                border-radius: 20px;
                box-shadow: 0 10px 35px rgba(0,0,0,.08);
            }

            .logo {
                text-align: center;
                font-size: 28px;
                font-weight: bold;
                color: #7131e8;
                margin-bottom: 10px;
            }

            .title {
                text-align: center;
                font-size: 22px;
                margin-bottom: 8px;
            }

            .subtitle {
                text-align: center;
                color: #777;
                font-size: 14px;
                margin-bottom: 30px;
            }

            label {
                display: block;
                margin-bottom: 7px;
                font-weight: 600;
                font-size: 14px;
            }

            input {
                width: 100%;
                padding: 13px;
                border: 1px solid #ddd;
                border-radius: 10px;
                margin-bottom: 18px;
                outline: none;
            }

                input:focus {
                    border-color: #7131e8;
                }

            button {
                width: 100%;
                padding: 14px;
                border: none;
                border-radius: 10px;
                background: #7131e8;
                color: white;
                font-size: 15px;
                font-weight: bold;
                cursor: pointer;
            }

                button:hover {
                    background: #5f20d0;
                }

            .error {
                color: #d14d62;
                font-size: 13px;
                margin-bottom: 15px;
                text-align: center;
                display: none;
            }

            .back {
                text-align: center;
                margin-top: 20px;
            }

                .back a {
                    color: #7131e8;
                    text-decoration: none;
                    font-size: 14px;
                }
    </style>
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")


    <div class="login-box">

        <div class="logo">🐾 PetHope</div>

        <h2 class="title">
            Admin Login
        </h2>

        <p class="subtitle">
            Authorized administrator access only
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error" style="display:block;">
                @ViewBag.Error
            </div>
        }

        <form id="adminLoginForm"
              method="post"
              action="/Account/AdminLogin"
              autocomplete="on">

            <label>Email</label>

            <input type="email"
                   id="adminEmail"
                   name="email"
                   placeholder="Enter admin email"
                   autocomplete="username"
                   required>

            <label>Password</label>

            <input type="password"
                   id="adminPassword"
                   name="password"
                   placeholder="Enter password"
                   autocomplete="current-password"
                   required>

            <button type="submit">
                Login
            </button>

        </form>

        <div class="back">
            <a href="/Account/SignIn">
                ← Back to Sign In
            </a>
        </div>

    </div>

</body>
</html>