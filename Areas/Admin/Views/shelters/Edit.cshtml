@model PetWAMS.Web.Models.Shelter

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Edit Shelter — PetHope Admin</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f8f5fb;
                color: #24142e;
            }

            .topbar {
                background: #241A3D;
                color: white;
                padding: 22px 45px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .container {
                max-width: 800px;
                margin: 40px auto;
                padding: 0 25px;
            }

            .back {
                color: #7B2FF7;
                text-decoration: none;
                font-weight: bold;
            }

            h1 {
                margin: 25px 0 8px;
            }

            .subtitle {
                color: #756a7c;
                margin-bottom: 25px;
            }

            .card {
                background: white;
                padding: 30px;
                border-radius: 18px;
                box-shadow: 0 8px 30px rgba(0,0,0,.06);
            }

            .field {
                margin-bottom: 20px;
            }

            label {
                display: block;
                font-weight: bold;
                margin-bottom: 8px;
            }

            input,
            textarea {
                width: 100%;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 10px;
                font-size: 14px;
                font-family: Arial, sans-serif;
            }

            textarea {
                min-height: 100px;
                resize: vertical;
            }

            .btn {
                border: none;
                background: #7B2FF7;
                color: white;
                padding: 13px 22px;
                border-radius: 10px;
                font-weight: bold;
                cursor: pointer;
            }
    </style>
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")


    <div class="topbar">
        <strong>🐾 PetHope Admin</strong>
        <span>Edit Shelter</span>
    </div>

    <div class="container">

        <a href="/Admin/Shelters" class="back">
            ← Back to Shelters
        </a>

        <h1>Edit Shelter</h1>

        <div class="subtitle">
            Update shelter information.
        </div>

        <div class="card">

            <form method="post"
                  action="/Admin/Shelters/Edit">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="ShelterID"
                       value="@Model.ShelterID" />

                <div class="field">
                    <label>Shelter Name</label>

                    <input type="text"
                           name="ShelterName"
                           value="@Model.ShelterName"
                           required />
                </div>

                <div class="field">
                    <label>Address</label>

                    <textarea name="Address"
                              required>@Model.Address</textarea>
                </div>

                <div class="field">
                    <label>Contact Number</label>

                    <input type="text"
                           name="ContactNumber"
                           value="@Model.ContactNumber"
                           required />
                </div>

                <div class="field">
                    <label>Email</label>

                    <input type="email"
                           name="Email"
                           value="@Model.Email" />
                </div>

                <div class="field">
                    <label>Open Hours</label>

                    <input type="text"
                           name="OpenHours"
                           value="@Model.OpenHours" />
                </div>

                <button type="submit" class="btn">
                    Update Shelter
                </button>

            </form>

        </div>

    </div>

</body>
</html>
