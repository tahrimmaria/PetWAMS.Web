@using PetWAMS.Web.Models
@model PetWAMS.Web.ViewModels.PetShopSalesReportViewModel

@{
    Layout = null;

    int totalProducts =
        Convert.ToInt32(
            ViewBag.TotalProducts ?? 0);

    int pendingProducts =
        Convert.ToInt32(
            ViewBag.PendingProducts ?? 0);

    int approvedProducts =
        Convert.ToInt32(
            ViewBag.ApprovedProducts ?? 0);

    int rejectedProducts =
        Convert.ToInt32(
            ViewBag.RejectedProducts ?? 0);

    int lowStockProducts =
        Convert.ToInt32(
            ViewBag.LowStockProducts ?? 0);

    int totalOrders =
        Convert.ToInt32(
            ViewBag.TotalOrders ?? 0);

    int confirmedOrders =
        Convert.ToInt32(
            ViewBag.ConfirmedOrders ?? 0);

    int completedOrders =
        Convert.ToInt32(
            ViewBag.CompletedOrders ?? 0);

    int cancelledOrders =
        Convert.ToInt32(
            ViewBag.CancelledOrders ?? 0);

    int deliveredOrders =
        Convert.ToInt32(
            ViewBag.DeliveredOrders ?? 0);

    int cancellationRequests =
        Convert.ToInt32(
            ViewBag.CancellationRequests ?? 0);

    decimal totalRevenue =
        Convert.ToDecimal(
            ViewBag.TotalRevenue ?? 0);

    int totalComplaints =
        Convert.ToInt32(
            ViewBag.TotalComplaints ?? 0);

    int pendingComplaints =
        Convert.ToInt32(
            ViewBag.PendingComplaints ?? 0);

    int resolvedComplaints =
        Convert.ToInt32(
            ViewBag.ResolvedComplaints ?? 0);

    var lowStockList =
        ViewBag.LowStockList
            as List<PetShopProduct>
        ?? new List<PetShopProduct>();

    var recentOrders =
        ViewBag.RecentOrders
            as List<PetShopOrder>
        ?? new List<PetShopOrder>();

    var weeklyRanking =
        Model.WeeklyProductSales
        ?? new List<PetWAMS.Web.ViewModels.ProductSalesReportItemViewModel>();

    var monthlyRanking =
        Model.MonthlyProductSales
        ?? new List<PetWAMS.Web.ViewModels.ProductSalesReportItemViewModel>();

    var weeklyBestSeller =
        weeklyRanking
            .FirstOrDefault(item =>
                item.QuantitySold > 0);

    var monthlyBestSeller =
        monthlyRanking
            .FirstOrDefault(item =>
                item.QuantitySold > 0);

    int weeklyPositiveProductCount =
        weeklyRanking.Count(item =>
            item.QuantitySold > 0);

    int monthlyPositiveProductCount =
        monthlyRanking.Count(item =>
            item.QuantitySold > 0);

    int weeklyLowestPositiveSale =
        weeklyRanking
            .Where(item => item.QuantitySold > 0)
            .Select(item => item.QuantitySold)
            .DefaultIfEmpty(0)
            .Min();

    int monthlyLowestPositiveSale =
        monthlyRanking
            .Where(item => item.QuantitySold > 0)
            .Select(item => item.QuantitySold)
            .DefaultIfEmpty(0)
            .Min();
}

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Shop Sales Report - PetHope Admin</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700;800&family=DM+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
            :root {
                --purple: #7b2ff7;
                --purple-dark: #5c20c0;
                --purple-light: #f2e9fe;
                --bg: #f8f5fb;
                --text: #24142e;
                --muted: #756a7c;
                --line: #eee7f4;
                --green-bg: #e7f8ec;
                --green: #258447;
                --red-bg: #fde7ea;
                --red: #c23e52;
                --yellow-bg: #fff4d9;
                --yellow: #a46b00;
                --blue-bg: #eaf3ff;
                --blue: #2869b2;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: "DM Sans", Arial, sans-serif;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .page {
                display: grid;
                grid-template-columns: 280px 1fr;
                min-height: 100vh;
            }

            .sidebar {
                background: #ffffff;
                border-right: 1px solid var(--line);
                padding: 32px 24px;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 42px;
                color: var(--purple);
                font-family: "Fraunces", Georgia, serif;
                font-size: 26px;
                font-weight: 800;
            }

            .logo-mark {
                width: 38px;
                height: 38px;
                border-radius: 12px;
                background: linear-gradient( 135deg, var(--purple), #b383f5 );
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .panel-title {
                margin-bottom: 12px;
                color: #a092ad;
                font-size: 12px;
                font-weight: 900;
                text-transform: uppercase;
            }

            .menu {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

                .menu a {
                    min-height: 52px;
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 0 16px;
                    border-radius: 12px;
                    color: #5c5268;
                    font-size: 16px;
                    font-weight: 800;
                }

                    .menu a.active {
                        background: var(--purple);
                        color: #ffffff;
                    }

                    .menu a:hover {
                        background: var(--purple-light);
                        color: var(--purple);
                    }

                    .menu a.active:hover {
                        background: var(--purple-dark);
                        color: #ffffff;
                    }

            .logout {
                color: #d9435e !important;
                margin-top: 20px;
            }

            .main {
                min-width: 0;
                padding: 36px 48px 70px;
            }

            .top-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 18px;
                margin-bottom: 28px;
            }

                .top-row h1 {
                    font-family: "Fraunces", Georgia, serif;
                    font-size: 36px;
                    font-weight: 800;
                }

            .top-actions {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

            .top-btn {
                background: var(--purple-light);
                color: var(--purple);
                padding: 12px 18px;
                border-radius: 30px;
                font-weight: 900;
            }

                .top-btn.primary {
                    background: var(--purple);
                    color: #ffffff;
                }

            .hero {
                background: linear-gradient( 135deg, #2b1b4d, #8b35f7 );
                color: #ffffff;
                border-radius: 22px;
                padding: 30px;
                margin-bottom: 28px;
            }

                .hero h2 {
                    margin-bottom: 8px;
                    font-family: "Fraunces", Georgia, serif;
                    font-size: 30px;
                }

                .hero p {
                    max-width: 850px;
                    color: rgba(255, 255, 255, 0.88);
                    line-height: 1.65;
                    font-weight: 600;
                }

            .generated-at {
                display: inline-flex;
                margin-top: 16px;
                padding: 7px 12px;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.14);
                color: #ffffff;
                font-size: 12px;
                font-weight: 800;
            }

            .stats {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 18px;
                margin-bottom: 28px;
            }

            .stat-card {
                background: #ffffff;
                border: 1px solid var(--line);
                border-radius: 18px;
                padding: 22px;
                box-shadow: 0 8px 25px rgba(36, 20, 46, 0.04);
            }

                .stat-card .icon {
                    font-size: 28px;
                    margin-bottom: 12px;
                }

                .stat-card strong {
                    display: block;
                    margin-bottom: 4px;
                    font-size: 28px;
                    font-weight: 900;
                }

                .stat-card span {
                    color: var(--muted);
                    font-weight: 700;
                }

            .section {
                background: #ffffff;
                border: 1px solid var(--line);
                border-radius: 20px;
                padding: 24px;
                margin-bottom: 28px;
                box-shadow: 0 8px 25px rgba(36, 20, 46, 0.04);
            }

            .section-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 20px;
            }

            .section-title {
                margin: 0 0 6px;
                font-size: 24px;
                font-weight: 900;
            }

            .section-description {
                margin: 0;
                color: var(--muted);
                font-size: 13px;
                line-height: 1.6;
            }

            .date-badge {
                display: inline-flex;
                flex: 0 0 auto;
                padding: 8px 13px;
                border-radius: 999px;
                background: var(--purple-light);
                color: var(--purple);
                font-size: 12px;
                font-weight: 900;
            }

            .period-summary {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 14px;
                margin-bottom: 22px;
            }

            .period-stat {
                padding: 17px;
                border: 1px solid #eee5f5;
                border-radius: 15px;
                background: #faf8fd;
            }

                .period-stat span {
                    display: block;
                    margin-bottom: 7px;
                    color: var(--muted);
                    font-size: 11px;
                    font-weight: 800;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                }

                .period-stat strong {
                    color: #33213e;
                    font-size: 21px;
                    font-weight: 900;
                    word-break: break-word;
                }

            .best-seller-card {
                margin-bottom: 22px;
                padding: 18px 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 18px;
                border: 1px solid #bee8cc;
                border-radius: 16px;
                background: linear-gradient( 135deg, #effbf3, #f9fffb );
            }

            .best-seller-label {
                display: block;
                margin-bottom: 6px;
                color: var(--green);
                font-size: 11px;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .best-seller-name {
                color: #23472f;
                font-size: 18px;
                font-weight: 900;
            }

            .best-seller-details {
                color: #577260;
                font-size: 12px;
                font-weight: 700;
                text-align: right;
                line-height: 1.6;
            }

            .table-wrapper {
                width: 100%;
                overflow-x: auto;
                border: 1px solid var(--line);
                border-radius: 16px;
            }

            .ranking-table {
                width: 100%;
                min-width: 850px;
                border-collapse: collapse;
            }

                .ranking-table thead {
                    background: #f5effb;
                }

                .ranking-table th {
                    padding: 14px 15px;
                    color: #5c4968;
                    font-size: 11px;
                    font-weight: 900;
                    text-align: left;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                }

                .ranking-table td {
                    padding: 15px;
                    border-top: 1px solid var(--line);
                    color: #46384f;
                    font-size: 13px;
                    vertical-align: middle;
                }

                .ranking-table tbody tr:hover {
                    background: #fdfbff;
                }

            .rank-number {
                width: 35px;
                height: 35px;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: var(--purple-light);
                color: var(--purple);
                font-size: 13px;
                font-weight: 900;
            }

                .rank-number.first {
                    background: #fff0bd;
                    color: #896000;
                }

            .product-name {
                display: block;
                margin-bottom: 4px;
                color: #302039;
                font-size: 14px;
                font-weight: 900;
            }

            .product-id {
                color: #9a8da2;
                font-size: 11px;
                font-weight: 700;
            }

            .quantity-value,
            .revenue-value,
            .stock-value {
                font-weight: 900;
                white-space: nowrap;
            }

            .performance-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 7px 11px;
                border-radius: 999px;
                font-size: 11px;
                font-weight: 900;
                white-space: nowrap;
            }

            .performance-best {
                background: #fff0bd;
                color: #896000;
            }

            .performance-high {
                background: var(--green-bg);
                color: var(--green);
            }

            .performance-regular {
                background: var(--blue-bg);
                color: var(--blue);
            }

            .performance-low {
                background: var(--yellow-bg);
                color: var(--yellow);
            }

            .performance-none {
                background: var(--red-bg);
                color: var(--red);
            }

            .report-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 18px;
            }

            .mini-card {
                background: #faf8fd;
                border: 1px solid #f0e9f5;
                border-radius: 16px;
                padding: 18px;
            }

                .mini-card h3 {
                    margin-bottom: 12px;
                    font-size: 18px;
                    font-weight: 900;
                }

            .row {
                display: flex;
                justify-content: space-between;
                gap: 16px;
                padding: 9px 0;
                border-bottom: 1px solid #eeeeee;
                font-weight: 700;
            }

                .row:last-child {
                    border-bottom: none;
                }

                .row span {
                    color: var(--muted);
                }

                .row strong {
                    text-align: right;
                }

            .badge {
                display: inline-block;
                padding: 6px 11px;
                border-radius: 20px;
                background: var(--purple-light);
                color: var(--purple);
                font-size: 12px;
                font-weight: 900;
            }

                .badge.green {
                    background: var(--green-bg);
                    color: var(--green);
                }

                .badge.red {
                    background: var(--red-bg);
                    color: var(--red);
                }

                .badge.yellow {
                    background: var(--yellow-bg);
                    color: var(--yellow);
                }

            .empty {
                padding: 18px 0;
                color: var(--muted);
                font-weight: 800;
            }

            @@media (max-width: 1200px) {
                .period-summary {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }

            @@media (max-width: 1100px) {
                .page {
                    grid-template-columns: 1fr;
                }

                .stats {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }

                .report-grid {
                    grid-template-columns: 1fr;
                }

                .sidebar {
                    border-right: none;
                    border-bottom: 1px solid var(--line);
                }
            }

            @@media (max-width: 650px) {
                .main {
                    padding: 26px 20px 50px;
                }

                .stats,
                .period-summary {
                    grid-template-columns: 1fr;
                }

                .top-row,
                .section-header,
                .best-seller-card {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .best-seller-details {
                    text-align: left;
                }

                .row {
                    flex-direction: column;
                    gap: 4px;
                }

                    .row strong {
                        text-align: left;
                    }
            }
    </style>
</head>

<body>
    <div class="page">
        <aside class="sidebar">
            <a href="/Admin"
               class="logo">

                <span class="logo-mark">🐾</span>
                <span>PetHope</span>
            </a>

            <div class="panel-title">
                Admin Panel
            </div>

            <nav class="menu">
                <a href="/Admin">
                    🏠 Dashboard
                </a>

                <a href="/Admin/PetShop">
                    🛒 Shop Products
                </a>

                <a href="/Admin/PetShop/Orders">
                    📦 Shop Orders
                </a>

                <a href="/Admin/PetShop/Complaints">
                    💬 Complaints
                </a>

                <a href="/Admin/PetShop/Report"
                   class="active">

                    📊 Shop Report
                </a>

                <a href="/Account/Logout"
                   class="logout">

                    ↩ Logout
                </a>
            </nav>
        </aside>

        <main class="main">
            <div class="top-row">
                <h1>Pet Care Shop Report</h1>

                <div class="top-actions">
                    <a href="/Admin/PetShop"
                       class="top-btn">

                        Products
                    </a>

                    <a href="/Admin/PetShop/Orders"
                       class="top-btn">

                        Orders
                    </a>

                    <a href="/Admin/PetShop/Complaints"
                       class="top-btn primary">

                        Complaints
                    </a>
                </div>
            </div>

            <section class="hero">
                <h2>Sales and Management Report</h2>

                <p>
                    Monitor weekly and monthly product sales,
                    identify best-selling and low-selling products,
                    review revenue, inventory, orders and customer
                    complaint activity.
                </p>

                <span class="generated-at">
                    Generated:
                    @Model.GeneratedAt.ToString(
                        "dd MMMM yyyy, hh:mm tt")
                </span>
            </section>

            <section class="stats">
                <div class="stat-card">
                    <div class="icon">🛒</div>

                    <strong>@totalProducts</strong>

                    <span>Total Products</span>
                </div>

                <div class="stat-card">
                    <div class="icon">📦</div>

                    <strong>@totalOrders</strong>

                    <span>Total Orders</span>
                </div>

                <div class="stat-card">
                    <div class="icon">💰</div>

                    <strong>
                        ৳@totalRevenue.ToString("0.00")
                    </strong>

                    <span>Valid Sales Revenue</span>
                </div>

                <div class="stat-card">
                    <div class="icon">💬</div>

                    <strong>@totalComplaints</strong>

                    <span>Total Complaints</span>
                </div>
            </section>

            <section class="section">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">
                            Weekly Product Sales Ranking
                        </h2>

                        <p class="section-description">
                            Products are ranked by quantity sold.
                            Revenue and product name resolve equal
                            quantities.
                        </p>
                    </div>

                    <span class="date-badge">
                        @Model.WeekStart.ToString("dd MMM")
                        -
                        @Model.WeekEnd.ToString("dd MMM yyyy")
                    </span>
                </div>

                <div class="period-summary">
                    <div class="period-stat">
                        <span>Paid Orders</span>
                        <strong>
                            @Model.WeeklyOrderCount
                        </strong>
                    </div>

                    <div class="period-stat">
                        <span>Units Sold</span>
                        <strong>
                            @Model.WeeklyUnitsSold
                        </strong>
                    </div>

                    <div class="period-stat">
                        <span>Sales Revenue</span>
                        <strong>
                            ৳@Model.WeeklyRevenue.ToString("0.00")
                        </strong>
                    </div>

                    <div class="period-stat">
                        <span>Products With Sales</span>
                        <strong>
                            @weeklyPositiveProductCount
                        </strong>
                    </div>
                </div>

                @if (weeklyBestSeller != null)
                {
                    <div class="best-seller-card">
                        <div>
                            <span class="best-seller-label">
                                Weekly Best Seller
                            </span>

                            <div class="best-seller-name">
                                @weeklyBestSeller.ProductName
                            </div>
                        </div>

                        <div class="best-seller-details">
                            @weeklyBestSeller.QuantitySold units sold
                            <br />
                            ৳@weeklyBestSeller.Revenue.ToString("0.00")
                            revenue
                        </div>
                    </div>
                }

                @if (weeklyRanking.Count == 0)
                {
                    <div class="empty">
                        No approved product was found.
                    </div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="ranking-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Pet Type</th>
                                    <th>Units Sold</th>
                                    <th>Revenue</th>
                                    <th>Current Stock</th>
                                    <th>Performance</th>
                                </tr>
                            </thead>

                            <tbody>
                                @for (int index = 0;
                                    index < weeklyRanking.Count;
                                    index++)
                                {
                                    var item =
                                        weeklyRanking[index];

                                    string performanceText =
                                        "Regular";

                                    string performanceClass =
                                        "performance-regular";

                                    if (item.QuantitySold == 0)
                                    {
                                        performanceText =
                                            "No Sales";

                                        performanceClass =
                                            "performance-none";
                                    }
                                    else if (index == 0)
                                    {
                                        performanceText =
                                            "Best Seller";

                                        performanceClass =
                                            "performance-best";
                                    }
                                    else if (
                                        weeklyPositiveProductCount > 1
                                        && item.QuantitySold
                                            == weeklyLowestPositiveSale)
                                    {
                                        performanceText =
                                            "Low Selling";

                                        performanceClass =
                                            "performance-low";
                                    }
                                    else if (index <= 2)
                                    {
                                        performanceText =
                                            "High Selling";

                                        performanceClass =
                                            "performance-high";
                                    }

                                    <tr>
                                        <td>
                                            <span class="rank-number @(index == 0 && item.QuantitySold > 0 ? "first" : "")">
                                                @(index + 1)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="product-name">
                                                @item.ProductName
                                            </span>

                                            <span class="product-id">
                                                Product ID:
                                                #@item.ProductID
                                            </span>
                                        </td>

                                        <td>
                                            @item.ProductCategory
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(
                                                item.PetType)
                                                ? "All"
                                                : item.PetType)
                                        </td>

                                        <td>
                                            <span class="quantity-value">
                                                @item.QuantitySold
                                            </span>
                                        </td>

                                        <td>
                                            <span class="revenue-value">
                                                ৳@item.Revenue.ToString("0.00")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="stock-value">
                                                @item.CurrentStock
                                            </span>
                                        </td>

                                        <td>
                                            <span class="performance-badge @performanceClass">
                                                @performanceText
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="section">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">
                            Monthly Product Sales Ranking
                        </h2>

                        <p class="section-description">
                            Current-month paid sales from highest
                            quantity to lowest quantity.
                        </p>
                    </div>

                    <span class="date-badge">
                        @Model.MonthStart.ToString("dd MMM")
                        -
                        @Model.MonthEnd.ToString("dd MMM yyyy")
                    </span>
                </div>

                <div class="period-summary">
                    <div class="period-stat">
                        <span>Paid Orders</span>
                        <strong>
                            @Model.MonthlyOrderCount
                        </strong>
                    </div>

                    <div class="period-stat">
                        <span>Units Sold</span>
                        <strong>
                            @Model.MonthlyUnitsSold
                        </strong>
                    </div>

                    <div class="period-stat">
                        <span>Sales Revenue</span>
                        <strong>
                            ৳@Model.MonthlyRevenue.ToString("0.00")
                        </strong>
                    </div>

                    <div class="period-stat">
                        <span>Products With Sales</span>
                        <strong>
                            @monthlyPositiveProductCount
                        </strong>
                    </div>
                </div>

                @if (monthlyBestSeller != null)
                {
                    <div class="best-seller-card">
                        <div>
                            <span class="best-seller-label">
                                Monthly Best Seller
                            </span>

                            <div class="best-seller-name">
                                @monthlyBestSeller.ProductName
                            </div>
                        </div>

                        <div class="best-seller-details">
                            @monthlyBestSeller.QuantitySold units sold
                            <br />
                            ৳@monthlyBestSeller.Revenue.ToString("0.00")
                            revenue
                        </div>
                    </div>
                }

                @if (monthlyRanking.Count == 0)
                {
                    <div class="empty">
                        No approved product was found.
                    </div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="ranking-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Pet Type</th>
                                    <th>Units Sold</th>
                                    <th>Revenue</th>
                                    <th>Current Stock</th>
                                    <th>Performance</th>
                                </tr>
                            </thead>

                            <tbody>
                                @for (int index = 0;
                                    index < monthlyRanking.Count;
                                    index++)
                                {
                                    var item =
                                        monthlyRanking[index];

                                    string performanceText =
                                        "Regular";

                                    string performanceClass =
                                        "performance-regular";

                                    if (item.QuantitySold == 0)
                                    {
                                        performanceText =
                                            "No Sales";

                                        performanceClass =
                                            "performance-none";
                                    }
                                    else if (index == 0)
                                    {
                                        performanceText =
                                            "Best Seller";

                                        performanceClass =
                                            "performance-best";
                                    }
                                    else if (
                                        monthlyPositiveProductCount > 1
                                        && item.QuantitySold
                                            == monthlyLowestPositiveSale)
                                    {
                                        performanceText =
                                            "Low Selling";

                                        performanceClass =
                                            "performance-low";
                                    }
                                    else if (index <= 2)
                                    {
                                        performanceText =
                                            "High Selling";

                                        performanceClass =
                                            "performance-high";
                                    }

                                    <tr>
                                        <td>
                                            <span class="rank-number @(index == 0 && item.QuantitySold > 0 ? "first" : "")">
                                                @(index + 1)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="product-name">
                                                @item.ProductName
                                            </span>

                                            <span class="product-id">
                                                Product ID:
                                                #@item.ProductID
                                            </span>
                                        </td>

                                        <td>
                                            @item.ProductCategory
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(
                                                item.PetType)
                                                ? "All"
                                                : item.PetType)
                                        </td>

                                        <td>
                                            <span class="quantity-value">
                                                @item.QuantitySold
                                            </span>
                                        </td>

                                        <td>
                                            <span class="revenue-value">
                                                ৳@item.Revenue.ToString("0.00")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="stock-value">
                                                @item.CurrentStock
                                            </span>
                                        </td>

                                        <td>
                                            <span class="performance-badge @performanceClass">
                                                @performanceText
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="section">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">
                            Management Summary
                        </h2>

                        <p class="section-description">
                            Product, order, cancellation and complaint
                            information.
                        </p>
                    </div>
                </div>

                <div class="report-grid">
                    <div class="mini-card">
                        <h3>
                            Product Approval &amp; Inventory
                        </h3>

                        <div class="row">
                            <span>Approved Products</span>
                            <strong>@approvedProducts</strong>
                        </div>

                        <div class="row">
                            <span>Pending Products</span>
                            <strong>@pendingProducts</strong>
                        </div>

                        <div class="row">
                            <span>Rejected Products</span>
                            <strong>@rejectedProducts</strong>
                        </div>

                        <div class="row">
                            <span>Low Stock Products</span>
                            <strong>@lowStockProducts</strong>
                        </div>
                    </div>

                    <div class="mini-card">
                        <h3>Order &amp; Cancellation</h3>

                        <div class="row">
                            <span>Confirmed Orders</span>
                            <strong>@confirmedOrders</strong>
                        </div>

                        <div class="row">
                            <span>Completed Orders</span>
                            <strong>@completedOrders</strong>
                        </div>

                        <div class="row">
                            <span>Delivered Orders</span>
                            <strong>@deliveredOrders</strong>
                        </div>

                        <div class="row">
                            <span>Cancelled Orders</span>
                            <strong>@cancelledOrders</strong>
                        </div>

                        <div class="row">
                            <span>Pending Cancellation Requests</span>
                            <strong>@cancellationRequests</strong>
                        </div>
                    </div>

                    <div class="mini-card">
                        <h3>Complaint Handling</h3>

                        <div class="row">
                            <span>Total Complaints</span>
                            <strong>@totalComplaints</strong>
                        </div>

                        <div class="row">
                            <span>Pending Complaints</span>
                            <strong>@pendingComplaints</strong>
                        </div>

                        <div class="row">
                            <span>Resolved Complaints</span>
                            <strong>@resolvedComplaints</strong>
                        </div>
                    </div>

                    <div class="mini-card">
                        <h3>Business Rules</h3>

                        <div class="row">
                            <span>Paid Sales Only</span>
                            <strong>Active</strong>
                        </div>

                        <div class="row">
                            <span>Refund Exclusion</span>
                            <strong>Active</strong>
                        </div>

                        <div class="row">
                            <span>Stock Auto Update</span>
                            <strong>Active</strong>
                        </div>

                        <div class="row">
                            <span>Sales Ranking</span>
                            <strong>Active</strong>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">
                            Low Stock Products
                        </h2>

                        <p class="section-description">
                            Products at or below their configured
                            stock limit.
                        </p>
                    </div>
                </div>

                @if (lowStockList.Count == 0)
                {
                    <div class="empty">
                        No low stock product found.
                    </div>
                }
                else
                {
                    @foreach (var product in lowStockList)
                    {
                        <div class="row">
                            <span>
                                @product.ProductName

                                <span class="badge yellow">
                                    @product.ProductCategory
                                </span>
                            </span>

                            <strong>
                                Stock: @product.StockQuantity
                                /
                                Limit: @product.LowStockLimit
                            </strong>
                        </div>
                    }
                }
            </section>

            <section class="section">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">
                            Recent Orders
                        </h2>

                        <p class="section-description">
                            The five most recent shop orders.
                        </p>
                    </div>
                </div>

                @if (recentOrders.Count == 0)
                {
                    <div class="empty">
                        No recent order found.
                    </div>
                }
                else
                {
                    @foreach (var order in recentOrders)
                    {
                        string orderClass =
                            "green";

                        if (order.OrderStatus.Equals(
                            "Cancelled",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            orderClass =
                                "red";
                        }
                        else if (
                            order.CancellationRequested
                            && order.CancellationStatus.Equals(
                                "Pending Approval",
                                StringComparison.OrdinalIgnoreCase))
                        {
                            orderClass =
                                "yellow";
                        }

                        <div class="row">
                            <span>
                                @order.OrderNumber

                                <span class="badge @orderClass">
                                    @order.OrderStatus
                                </span>
                            </span>

                            <strong>
                                ৳@order.TotalAmount.ToString("0.00")
                            </strong>
                        </div>
                    }
                }
            </section>
        </main>
    </div>
</body>

</html>