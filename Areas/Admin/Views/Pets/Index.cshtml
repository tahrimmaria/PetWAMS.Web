@model List<PetWAMS.Web.Models.Pet>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Manage Pets — PetHope Admin</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f8f5fb;
                color: #24142e;
            }

            .topbar {
                background: #241A3D;
                color: white;
                padding: 22px 45px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .container {
                max-width: 1250px;
                margin: 40px auto;
                padding: 0 25px;
            }

            .back {
                color: #7B2FF7;
                text-decoration: none;
                font-weight: bold;
            }

            .heading-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
                margin: 25px 0;
            }

            h1 {
                margin: 0;
            }

            .add-btn {
                display: inline-block;
                background: #7B2FF7;
                color: white;
                padding: 12px 20px;
                border-radius: 10px;
                text-decoration: none;
                font-weight: bold;
            }

            .alert {
                background: #FDEBE7;
                color: #B63E4D;
                border: 1px solid #F4C7CD;
                padding: 14px 18px;
                border-radius: 10px;
                margin-bottom: 20px;
                font-weight: bold;
            }

            .table-card {
                background: white;
                border-radius: 18px;
                overflow-x: auto;
                box-shadow: 0 8px 30px rgba(0,0,0,.06);
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 1050px;
            }

            th {
                background: #F3EDFB;
                text-align: left;
                padding: 15px;
                font-size: 13px;
            }

            td {
                padding: 15px;
                border-top: 1px solid #eee;
                font-size: 14px;
            }

            .status {
                padding: 6px 11px;
                border-radius: 20px;
                background: #F2E9FE;
                color: #7B2FF7;
                font-weight: bold;
                font-size: 12px;
                display: inline-block;
            }

            .view-btn,
            .edit-btn {
                text-decoration: none;
                font-weight: bold;
                margin-right: 8px;
            }

            .view-btn {
                color: #2E8A4C;
            }

            .edit-btn {
                color: #7B2FF7;
            }

            .delete-btn {
                border: 0;
                background: #FDEBE7;
                color: #C34A5A;
                padding: 7px 11px;
                border-radius: 8px;
                font-weight: bold;
                cursor: pointer;
            }

            .empty {
                text-align: center;
                color: #756a7c;
                padding: 35px;
            }
    </style>
</head>

<body>
    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")

    <div class="topbar">
        <strong>🐾 PetHope Admin</strong>
        <span>Manage Pets</span>
    </div>

    <div class="container">

        <div class="heading-row">

            <h1>All Pets</h1>

            <a href="/Admin/Pets/Create"
               class="add-btn">
                + Add Pet
            </a>

        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert">
                @TempData["Error"]
            </div>
        }

        <div class="table-card">

            <table>

                <tr>
                    <th>ID</th>
                    <th>Pet</th>
                    <th>Breed</th>
                    <th>Age</th>
                    <th>Category</th>
                    <th>Shelter</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>

                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="empty">
                            No pets found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var pet in Model)
                    {
                        <tr>

                            <td>
                                #@pet.PetID
                            </td>

                            <td>
                                @pet.PetName
                            </td>

                            <td>
                                @pet.Breed
                            </td>

                            <td>
                                @pet.Age
                            </td>

                            <td>
                                @pet.Category?.CategoryName
                            </td>

                            <td>
                                @pet.Shelter?.ShelterName
                            </td>

                            <td>
                                <span class="status">
                                    @pet.Status
                                </span>
                            </td>

                            <td>

                                <a href="/Pets/Details/@pet.PetID"
                                   class="view-btn">
                                    View
                                </a>

                                <a href="/Admin/Pets/Edit/@pet.PetID"
                                   class="edit-btn">
                                    Edit
                                </a>

                                <form method="post"
                                      action="/Admin/Pets/Delete/@pet.PetID"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this pet?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="delete-btn">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }
                }

            </table>

        </div>

    </div>

</body>
</html>