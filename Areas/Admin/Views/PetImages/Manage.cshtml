@model List<PetWAMS.Web.Models.PetImage>

@{
    Layout = null;

    var pet = ViewBag.Pet as PetWAMS.Web.Models.Pet;
    string petName = pet == null ? "Selected Pet" : pet.PetName;
    int petId = pet == null ? 0 : pet.PetID;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Pet Images — Admin — PetHope</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700;800&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --purple: #7B2FF7;
                --purple-dark: #5A1FB8;
                --purple-light: #F2E9FE;
                --bg: #f8f5fb;
                --text: #24142e;
                --muted: #756a7c;
                --line: #eee7f4;
                --green-bg: #E7F8EC;
                --green: #258447;
                --red-bg: #FDE7EA;
                --red: #C23E52;
                --yellow-bg: #FFF4D9;
                --yellow: #A46B00;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--bg);
                color: var(--text);
                font-family: 'DM Sans', Arial, sans-serif;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            .page {
                max-width: 1120px;
                margin: 0 auto;
                padding: 38px 24px 80px;
            }

            .topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 18px;
                margin-bottom: 28px;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: 'Fraunces', Georgia, serif;
                font-size: 28px;
                font-weight: 800;
                color: var(--purple);
            }

            .brand-mark {
                width: 42px;
                height: 42px;
                border-radius: 13px;
                background: linear-gradient(135deg, var(--purple), #B383F5);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffffff;
            }

            .top-actions {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .btn {
                border: none;
                background: var(--purple-light);
                color: var(--purple);
                padding: 12px 20px;
                border-radius: 999px;
                font-family: inherit;
                font-weight: 900;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .btn.primary {
                    background: var(--purple);
                    color: #ffffff;
                }

            .card {
                background: #ffffff;
                border: 1px solid var(--line);
                border-radius: 24px;
                padding: 30px;
                box-shadow: 0 8px 25px rgba(36,20,46,.05);
                margin-bottom: 24px;
            }

            h1 {
                font-family: 'Fraunces', Georgia, serif;
                font-size: 38px;
                margin: 0 0 8px;
            }

            h2 {
                font-size: 24px;
                font-weight: 900;
                margin: 0 0 16px;
            }

            .subtitle {
                color: var(--muted);
                font-weight: 700;
                line-height: 1.6;
                margin-bottom: 24px;
            }

            .pet-info {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 12px;
                margin-top: 20px;
            }

            .info-box {
                background: #faf8fd;
                border: 1px solid #f0e9f5;
                border-radius: 14px;
                padding: 12px;
            }

                .info-box span {
                    display: block;
                    color: var(--muted);
                    font-size: 12px;
                    font-weight: 800;
                    margin-bottom: 5px;
                }

                .info-box strong {
                    color: var(--text);
                    font-weight: 900;
                    font-size: 14px;
                }

            .success {
                background: var(--green-bg);
                color: var(--green);
                padding: 14px 18px;
                border-radius: 14px;
                font-weight: 800;
                margin-bottom: 16px;
            }

            .upload-box {
                border: 2px dashed #d8c6ef;
                background: #faf8fd;
                border-radius: 18px;
                padding: 22px;
            }

                .upload-box strong {
                    display: block;
                    font-weight: 900;
                    margin-bottom: 10px;
                }

            input[type="file"] {
                width: 100%;
                border: 1px solid var(--line);
                background: #ffffff;
                border-radius: 14px;
                padding: 13px;
                font-family: inherit;
            }

            .upload-note {
                color: var(--muted);
                font-weight: 700;
                line-height: 1.5;
                margin-top: 10px;
                font-size: 14px;
            }

            .upload-actions {
                margin-top: 18px;
            }

            .image-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 18px;
            }

            .image-card {
                background: #faf8fd;
                border: 1px solid var(--line);
                border-radius: 18px;
                padding: 12px;
            }

            .image-box {
                height: 165px;
                border-radius: 14px;
                overflow: hidden;
                background: #ffffff;
                border: 1px solid #f0e9f5;
                margin-bottom: 12px;
            }

                .image-box img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    background: #ffffff;
                }

            .primary-badge {
                display: inline-block;
                background: var(--green-bg);
                color: var(--green);
                padding: 7px 12px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 900;
                margin-bottom: 10px;
            }

            .normal-badge {
                display: inline-block;
                background: var(--yellow-bg);
                color: var(--yellow);
                padding: 7px 12px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 900;
                margin-bottom: 10px;
            }

            .image-actions {
                display: grid;
                gap: 8px;
            }

            .small-btn {
                border: none;
                border-radius: 999px;
                padding: 10px 12px;
                font-family: inherit;
                font-weight: 900;
                cursor: pointer;
                background: var(--purple);
                color: #ffffff;
                width: 100%;
            }

                .small-btn.danger {
                    background: var(--red);
                }

            .empty {
                background: #faf8fd;
                border: 1px dashed #d8c6ef;
                border-radius: 18px;
                padding: 28px;
                color: var(--muted);
                font-weight: 800;
                text-align: center;
            }

            @@media (max-width: 950px) {
                .image-grid {
                    grid-template-columns: repeat(2, 1fr);
                }

                .pet-info {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 620px) {
                .topbar {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .image-grid {
                    grid-template-columns: 1fr;
                }

                .pet-info {
                    grid-template-columns: 1fr;
                }

                h1 {
                    font-size: 31px;
                }
            }
    </style>
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")


    <div class="page">

        <div class="topbar">
            <a href="/Admin/Dashboard" class="brand">
                <span class="brand-mark">🐾</span>
                <span>PetHope Admin</span>
            </a>

            <div class="top-actions">
                <a href="/Admin/PetImages" class="btn">Back to All Pets</a>
                <a href="/Pets/Details/@petId" class="btn primary">View Public Details</a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="success">@TempData["Success"]</div>
        }

        <div class="card">
            <h1>Manage Images</h1>

            <div class="subtitle">
                Upload multiple images for <b>@petName</b>. The primary image will show first on Browse Pets and Pet Details.
            </div>

            <div class="pet-info">
                <div class="info-box">
                    <span>Pet ID</span>
                    <strong>#@petId</strong>
                </div>

                <div class="info-box">
                    <span>Category</span>
                    <strong>@(pet?.Category == null ? "No Category" : pet.Category.CategoryName)</strong>
                </div>

                <div class="info-box">
                    <span>Breed</span>
                    <strong>@(pet?.Breed ?? "N/A")</strong>
                </div>

                <div class="info-box">
                    <span>Shelter</span>
                    <strong>@(pet?.Shelter == null ? "No Shelter" : pet.Shelter.ShelterName)</strong>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Upload New Images</h2>

            <form method="post"
                  action="/Admin/PetImages/Upload"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" name="petId" value="@petId" />

                <div class="upload-box">
                    <strong>Select Multiple Pet Images</strong>

                    <input type="file"
                           name="petImages"
                           accept=".jpg,.jpeg,.png,.webp"
                           multiple
                           required />

                    <div class="upload-note">
                        You can select multiple images together. Allowed files: JPG, JPEG, PNG, WEBP.
                        First uploaded image will be primary if this pet has no primary image.
                    </div>
                </div>

                <div class="upload-actions">
                    <button type="submit" class="btn primary">Upload Images</button>
                </div>

            </form>
        </div>

        <div class="card">
            <h2>Uploaded Images</h2>

            @if (Model == null || Model.Count == 0)
            {
                <div class="empty">
                    No images uploaded for this pet yet.
                </div>
            }
            else
            {
                <div class="image-grid">

                    @foreach (var image in Model)
                    {
                        <div class="image-card">

                            <div class="image-box">
                                <img src="@image.ImagePath" alt="@petName" />
                            </div>

                            @if (image.IsPrimary)
                            {
                                <div class="primary-badge">Primary Image</div>
                            }
                            else
                            {
                                <div class="normal-badge">Gallery Image</div>
                            }

                            <div class="image-actions">

                                @if (!image.IsPrimary)
                                {
                                    <form method="post" action="/Admin/PetImages/SetPrimaryImage">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="petId" value="@petId" />
                                        <input type="hidden" name="imageId" value="@image.PetImageID" />

                                        <button type="submit" class="small-btn">
                                            Set Primary
                                        </button>
                                    </form>
                                }

                                <form method="post"
                                      action="/Admin/PetImages/DeleteImage"
                                      onsubmit="return confirm('Delete this image?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="petId" value="@petId" />
                                    <input type="hidden" name="imageId" value="@image.PetImageID" />

                                    <button type="submit" class="small-btn danger">
                                        Delete Image
                                    </button>
                                </form>

                            </div>

                        </div>
                    }

                </div>
            }
        </div>

    </div>

</body>
</html>