@using PetWAMS.Web.Models

@{
    Layout = null;

    var fullName = ViewBag.FullName as string ?? "Admin User";
    var totalUsers = ViewBag.TotalUsers ?? 0;
    var totalShelters = ViewBag.TotalShelters ?? 0;
    var totalPets = ViewBag.TotalPets ?? 0;
    var totalRequests = ViewBag.TotalRequests ?? 0;

    int unreadCount = 0;

    if (ViewBag.UnreadNotificationsCount != null)
    {
        unreadCount = Convert.ToInt32(ViewBag.UnreadNotificationsCount);
    }

    var notifications =
        ViewBag.RecentNotifications as List<Notification>
        ?? new List<Notification>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard — PetHope</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=DM+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
            :root {
                --purple: #7B2FF7;
                --purple-dark: #5A1FB8;
                --purple-light: #F2E9FE;
                --dark: #241A3D;
                --bg: #f8f5fb;
                --text: #24142e;
                --muted: #756a7c;
                --card: #ffffff;
                --line: #eee7f4;
                --green-bg: #E7F8EC;
                --green: #258447;
                --red-bg: #FDE7EA;
                --red: #C23E52;
                --yellow-bg: #FFF4D9;
                --yellow: #A46B00;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: 'DM Sans', Arial, sans-serif;
                min-height: 100vh;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            .page {
                display: grid;
                grid-template-columns: 280px 1fr;
                min-height: 100vh;
            }

            .sidebar {
                background: #ffffff;
                border-right: 1px solid var(--line);
                padding: 32px 24px;
                display: flex;
                flex-direction: column;
            }

            .logo {
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: 'Fraunces', Georgia, serif;
                font-weight: 800;
                font-size: 26px;
                color: var(--purple);
                margin-bottom: 50px;
            }

            .logo-mark {
                width: 38px;
                height: 38px;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--purple), #B383F5);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                color: #ffffff;
            }

            .panel-title {
                font-size: 12px;
                font-weight: 900;
                color: #a092ad;
                letter-spacing: .04em;
                text-transform: uppercase;
                margin-bottom: 12px;
            }

            .menu {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

                .menu a {
                    min-height: 52px;
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 0 16px;
                    border-radius: 12px;
                    font-size: 16px;
                    font-weight: 800;
                    color: #5c5268;
                }

                    .menu a.active {
                        background: var(--purple);
                        color: #ffffff;
                    }

                    .menu a:hover {
                        background: #F2E9FE;
                        color: var(--purple);
                    }

                    .menu a.active:hover {
                        background: var(--purple);
                        color: #ffffff;
                    }

            .logout {
                margin-top: auto;
                color: #d9435e !important;
            }

            .main {
                padding: 36px 48px 70px;
            }

            .top-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 28px;
            }

                .top-row h1 {
                    font-size: 34px;
                    font-weight: 900;
                    color: var(--text);
                }

            .top-actions {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .notification-wrap {
                position: relative;
            }

            .bell-btn {
                width: 52px;
                height: 52px;
                border-radius: 50%;
                border: 1px solid var(--line);
                background: #ffffff;
                color: var(--purple);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 23px;
                cursor: pointer;
                box-shadow: 0 8px 22px rgba(36,20,46,.06);
                position: relative;
            }

            .bell-count {
                position: absolute;
                top: -6px;
                right: -4px;
                min-width: 22px;
                height: 22px;
                padding: 0 6px;
                border-radius: 999px;
                background: var(--red);
                color: #ffffff;
                font-size: 12px;
                font-weight: 900;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .notification-dropdown {
                display: none;
                position: absolute;
                top: 64px;
                right: 0;
                width: 420px;
                max-width: calc(100vw - 40px);
                background: #ffffff;
                border: 1px solid var(--line);
                border-radius: 22px;
                box-shadow: 0 18px 45px rgba(36,20,46,.14);
                padding: 16px;
                z-index: 100;
            }

            .notification-wrap.open .notification-dropdown {
                display: block;
            }

            .notification-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 12px;
            }

                .notification-head h3 {
                    font-size: 19px;
                    font-weight: 900;
                    color: var(--text);
                }

            .unread-pill {
                background: var(--purple-light);
                color: var(--purple);
                border-radius: 999px;
                padding: 7px 11px;
                font-size: 12px;
                font-weight: 900;
                white-space: nowrap;
            }

            .notification-list {
                display: grid;
                gap: 10px;
                max-height: 360px;
                overflow-y: auto;
                padding-right: 4px;
            }

            .notification-item {
                background: #fbf8ff;
                border: 1px solid var(--line);
                border-radius: 16px;
                padding: 13px;
            }

            .notification-title {
                font-weight: 900;
                color: var(--text);
                margin-bottom: 5px;
            }

            .notification-message {
                color: var(--muted);
                font-size: 14px;
                font-weight: 700;
                line-height: 1.4;
                margin-bottom: 7px;
            }

            .notification-date {
                color: #8d7c9d;
                font-size: 12px;
                font-weight: 800;
                margin-bottom: 10px;
            }

            .notification-open {
                display: inline-flex;
                background: #ffffff;
                color: var(--purple);
                border: 1px solid var(--line);
                border-radius: 999px;
                padding: 8px 15px;
                font-weight: 900;
                font-size: 13px;
            }

                .notification-open:hover {
                    background: var(--purple);
                    color: #ffffff;
                }

            .mark-all-btn {
                width: 100%;
                border: none;
                margin-top: 12px;
                background: var(--purple);
                color: #ffffff;
                border-radius: 999px;
                padding: 11px 16px;
                font-family: inherit;
                font-weight: 900;
                cursor: pointer;
            }

            .empty-notification {
                background: #fbf8ff;
                border: 1px dashed #ded2eb;
                border-radius: 16px;
                padding: 22px;
                text-align: center;
                color: var(--muted);
                font-weight: 800;
                line-height: 1.5;
            }

            .user-box {
                display: flex;
                align-items: center;
                gap: 12px;
                font-weight: 900;
            }

            .avatar {
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: var(--purple);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 900;
            }

            .hero {
                background: linear-gradient(135deg, #2B1B4D, #8B35F7);
                border-radius: 22px;
                padding: 34px;
                color: white;
                margin-bottom: 30px;
            }

                .hero h2 {
                    font-family: 'Fraunces', Georgia, serif;
                    font-size: 30px;
                    margin-bottom: 8px;
                }

                .hero p {
                    color: rgba(255,255,255,.86);
                    font-size: 16px;
                    line-height: 1.6;
                }

            .message-box {
                padding: 14px 18px;
                border-radius: 14px;
                font-weight: 800;
                margin-bottom: 18px;
            }

                .message-box.success {
                    background: var(--green-bg);
                    color: var(--green);
                }

            .stats {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 18px;
                margin-bottom: 34px;
            }

            .stat-card {
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: 18px;
                padding: 24px;
                box-shadow: 0 8px 25px rgba(36,20,46,.04);
            }

            .stat-icon {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                background: #F2E9FE;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 23px;
                margin-bottom: 16px;
            }

            .stat-number {
                font-size: 30px;
                font-weight: 900;
                color: var(--text);
                margin-bottom: 4px;
            }

            .stat-label {
                color: var(--muted);
                font-weight: 700;
            }

            .section-title {
                font-size: 24px;
                font-weight: 900;
                margin-bottom: 18px;
            }

            .management-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 18px;
                margin-bottom: 34px;
            }

            .management-card {
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: 18px;
                padding: 26px;
                box-shadow: 0 8px 25px rgba(36,20,46,.04);
                transition: .2s ease;
            }

                .management-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 18px 35px rgba(36,20,46,.09);
                }

                .management-card .big-icon {
                    font-size: 34px;
                    margin-bottom: 18px;
                }

                .management-card h3 {
                    font-size: 21px;
                    font-weight: 900;
                    margin-bottom: 8px;
                    color: var(--text);
                }

                .management-card p {
                    color: var(--muted);
                    line-height: 1.5;
                    font-weight: 600;
                }

            @@media (max-width: 1100px) {
                .stats,
                .management-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 800px) {
                .page {
                    grid-template-columns: 1fr;
                }

                .sidebar {
                    position: relative;
                    border-right: 0;
                    border-bottom: 1px solid var(--line);
                }

                .main {
                    padding: 28px 22px 50px;
                }

                .stats,
                .management-grid {
                    grid-template-columns: 1fr;
                }

                .top-row {
                    align-items: flex-start;
                    gap: 16px;
                    flex-direction: column;
                }

                .top-actions {
                    width: 100%;
                    justify-content: space-between;
                }

                .notification-dropdown {
                    left: 0;
                    right: auto;
                    width: calc(100vw - 44px);
                }
            }
    </style>
</head>

<body>

    <div class="page">

        <aside class="sidebar">

            <a href="/" class="logo">
                <span class="logo-mark">🐾</span>
                <span>PetHope</span>
            </a>

            <div class="panel-title">Admin Panel</div>

            <nav class="menu">
                <a href="/Admin" class="active">🏠 Dashboard</a>
                <a href="/Admin/Users">👥 Manage Users</a>
                <a href="/Admin/Shelters">🏥 Manage Shelters</a>
                <a href="/Admin/Pets">🐾 Manage Pets</a>
                <a href="/Admin/PetImages">🖼️ All Pet Images</a>
                <a href="/Admin/PetCategories">🏷️ Pet Categories</a>
                <a href="/Admin/AdoptionRequests">📋 Adoption Requests</a>
                <a href="/Admin/LostFound">🔎 Lost & Found</a>
                <a href="/Admin/PetShop">🛒 Pet Care Shop</a>
                <a href="/Account/Logout" class="logout">↩ Logout</a>
            </nav>

        </aside>

        <main class="main">

            <div class="top-row">
                <h1>Admin Dashboard</h1>

                <div class="top-actions">

                    <div class="notification-wrap" id="notificationWrap">

                        <button type="button"
                                class="bell-btn"
                                onclick="toggleNotifications()">
                            🔔

                            @if (unreadCount > 0)
                            {
                                <span class="bell-count">@unreadCount</span>
                            }
                        </button>

                        <div class="notification-dropdown">

                            <div class="notification-head">
                                <h3>Notifications</h3>
                                <span class="unread-pill">@unreadCount Unread</span>
                            </div>

                            @if (notifications.Count == 0)
                            {
                                <div class="empty-notification">
                                    No new notification.
                                    <br />
                                    Seen notifications will not show here.
                                </div>
                            }
                            else
                            {
                                <div class="notification-list">

                                    @foreach (var notification in notifications)
                                    {
                                        <div class="notification-item">
                                            <div class="notification-title">
                                                @notification.Title
                                            </div>

                                            <div class="notification-message">
                                                @notification.Message
                                            </div>

                                            <div class="notification-date">
                                                @notification.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                                            </div>

                                            <a href="/Admin/Dashboard/OpenNotification/@notification.NotificationID"
                                               class="notification-open">
                                                Open
                                            </a>
                                        </div>
                                    }

                                </div>

                                <form action="/Admin/Dashboard/MarkAllNotificationsAsRead"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="mark-all-btn">
                                        Mark All as Seen
                                    </button>
                                </form>
                            }

                        </div>

                    </div>

                    <div class="user-box">
                        <span>@fullName</span>
                        <div class="avatar">A</div>
                    </div>

                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="message-box success">
                    @TempData["Success"]
                </div>
            }

            <section class="hero">
                <h2>Welcome back, @fullName 👋</h2>
                <p>
                    Manage users, shelters, pets, adoption requests, lost & found reports
                    and Pet Care Shop business workflow from your dashboard.
                </p>
            </section>

            <section class="stats">

                <div class="stat-card">
                    <div class="stat-icon">👥</div>
                    <div class="stat-number">@totalUsers</div>
                    <div class="stat-label">Total Users</div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">🏥</div>
                    <div class="stat-number">@totalShelters</div>
                    <div class="stat-label">Total Shelters</div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">🐾</div>
                    <div class="stat-number">@totalPets</div>
                    <div class="stat-label">Total Pets</div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">📋</div>
                    <div class="stat-number">@totalRequests</div>
                    <div class="stat-label">Adoption Requests</div>
                </div>

            </section>

            <h2 class="section-title">Management</h2>

            <section class="management-grid">

                <a href="/Admin/Users" class="management-card">
                    <div class="big-icon">👥</div>
                    <h3>Manage Users</h3>
                    <p>View and manage registered adopters, shelters and admin users.</p>
                </a>

                <a href="/Admin/Shelters" class="management-card">
                    <div class="big-icon">🏥</div>
                    <h3>Manage Shelters</h3>
                    <p>View and manage shelter information and approval status.</p>
                </a>

                <a href="/Admin/Pets" class="management-card">
                    <div class="big-icon">🐾</div>
                    <h3>Manage Pets</h3>
                    <p>View and manage all pets available in the system.</p>
                </a>

                <a href="/Admin/PetImages" class="management-card">
                    <div class="big-icon">🖼️</div>
                    <h3>All Pet Images</h3>
                    <p>Upload multiple images for all shelter pets and set primary images.</p>
                </a>

                <a href="/Admin/PetCategories" class="management-card">
                    <div class="big-icon">🏷️</div>
                    <h3>Pet Categories</h3>
                    <p>Create and manage pet category records.</p>
                </a>

                <a href="/Admin/AdoptionRequests" class="management-card">
                    <div class="big-icon">📋</div>
                    <h3>Adoption Requests</h3>
                    <p>Monitor adoption requests. Shelter handles operational approval.</p>
                </a>

                <a href="/Admin/LostFound" class="management-card">
                    <div class="big-icon">🔎</div>
                    <h3>Lost & Found</h3>
                    <p>Monitor lost and found pet reports.</p>
                </a>

                <a href="/Admin/PetShop" class="management-card">
                    <div class="big-icon">🛒</div>
                    <h3>Pet Care Shop</h3>
                    <p>
                        Open shop module for products, orders, complaints and management report.
                    </p>
                </a>

            </section>

        </main>

    </div>

    <script>
            function toggleNotifications() {
                const wrapper = document.getElementById("notificationWrap");

                if (wrapper) {
                    wrapper.classList.toggle("open");
                }
            }

            document.addEventListener("click", function(event) {
                const wrapper = document.getElementById("notificationWrap");

                if (!wrapper) {
                    return;
                }

                const clickedInside = wrapper.contains(event.target);

                if (!clickedInside) {
                    wrapper.classList.remove("open");
                }
            });
    </script>

</body>
</html>