@model PetWAMS.Web.Models.LostPet
@using PetWAMS.Web.Models

@{
    Layout = null;
    var pets = ViewBag.Pets as List<Pet>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Report Lost Pet — PetHope</title>

    <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f8f5fb;
                color: #24142e;
            }

            .topbar {
                background: #241A3D;
                color: white;
                padding: 22px 45px;
                display: flex;
                justify-content: space-between;
            }

            .container {
                max-width: 800px;
                margin: 40px auto;
                padding: 0 25px;
            }

            .back {
                color: #7B2FF7;
                text-decoration: none;
                font-weight: bold;
            }

            h1 {
                margin: 25px 0;
            }

            .card {
                background: white;
                padding: 30px;
                border-radius: 18px;
                box-shadow: 0 8px 30px rgba(0,0,0,.06);
            }

            .field {
                margin-bottom: 20px;
            }

            label {
                display: block;
                font-weight: bold;
                margin-bottom: 8px;
            }

            input,
            select {
                width: 100%;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 10px;
                font-size: 14px;
                box-sizing: border-box;
            }

            .btn {
                border: 0;
                background: #C34A5A;
                color: white;
                padding: 12px 22px;
                border-radius: 10px;
                font-weight: bold;
                cursor: pointer;
            }
    </style>
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")


    <div class="topbar">
        <strong>🐾 PetHope</strong>
        <span>Report Lost Pet</span>
    </div>

    <div class="container">

        <a href="/Adopter/LostFound" class="back">
            ← Back to Lost & Found
        </a>

        <h1>Report Lost Pet</h1>

        <div class="card">

            <form method="post"
                  action="/Adopter/LostFound/CreateLost">

                @Html.AntiForgeryToken()

                <div class="field">
                    <label>Your Adopted Pet</label>

                    <select name="PetID" required>
                        <option value="">-- Select Pet --</option>

                        @if (pets != null)
                        {
                            @foreach (var pet in pets)
                            {
                                <option value="@pet.PetID">
                                    @pet.PetName
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="field">
                    <label>Lost Location</label>

                    <input type="text"
                           name="LostLocation"
                           placeholder="Example: Mirpur"
                           required />
                </div>

                <div class="field">
                    <label>Lost Date</label>

                    <input type="date"
                           name="LostDate"
                           required />
                </div>

                <div class="field">
                    <label>Contact Number</label>

                    <input type="text"
                           name="ContactNumber"
                           placeholder="01XXXXXXXXX"
                           required />
                </div>

                <button type="submit" class="btn">
                    Submit Lost Report
                </button>

            </form>

        </div>

    </div>

</body>
</html>