@model PetWAMS.Web.Models.User

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset Password — PetHope</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f8f5fb;
                color: #24142e;
            }

            .topbar {
                background: #241A3D;
                color: white;
                padding: 22px 45px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .container {
                max-width: 600px;
                margin: 50px auto;
                padding: 0 25px;
            }

            .back {
                color: #7B2FF7;
                text-decoration: none;
                font-weight: bold;
            }

            .card {
                background: white;
                margin-top: 25px;
                padding: 30px;
                border-radius: 18px;
                box-shadow: 0 8px 30px rgba(0,0,0,.06);
            }

            h1 {
                margin-top: 0;
                margin-bottom: 8px;
            }

            .user-info {
                color: #756a7c;
                margin-bottom: 25px;
            }

            .field {
                margin-bottom: 16px;
            }

                .field label {
                    display: block;
                    font-size: 13px;
                    font-weight: bold;
                    margin-bottom: 7px;
                }

                .field input {
                    width: 100%;
                    padding: 12px;
                    border: 1.5px solid #ddd;
                    border-radius: 10px;
                    outline: none;
                }

                    .field input:focus {
                        border-color: #7B2FF7;
                    }

            .error {
                background: #FDEBE7;
                color: #B63E4D;
                border: 1px solid #F4C7CD;
                padding: 12px 15px;
                border-radius: 10px;
                margin-bottom: 18px;
                font-weight: bold;
            }

            .save-btn {
                width: 100%;
                border: 0;
                background: #7B2FF7;
                color: white;
                padding: 13px;
                border-radius: 10px;
                font-weight: bold;
                cursor: pointer;
            }

                .save-btn:hover {
                    background: #6922df;
                }
    </style>
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")


    <div class="topbar">
        <strong>🐾 PetHope Admin</strong>
        <span>Reset Password</span>
    </div>

    <div class="container">

        <a href="/Admin/Users" class="back">
            ← Back to Manage Users
        </a>

        <div class="card">

            <h1>Reset Password</h1>

            <div class="user-info">
                Set a new password for
                <strong>@Model.FullName</strong>
                (@Model.Email)
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error">
                    @ViewBag.Error
                </div>
            }

            <form method="post"
                  action="/Admin/Users/ResetPassword/@Model.UserID"
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.UserID" />

                <div class="field">
                    <label>New Password</label>

                    <input type="password"
                           name="newPassword"
                           minlength="6"
                           autocomplete="new-password"
                           required />
                </div>

                <div class="field">
                    <label>Confirm Password</label>

                    <input type="password"
                           name="confirmPassword"
                           minlength="6"
                           autocomplete="new-password"
                           required />
                </div>

                <button type="submit"
                        class="save-btn">
                    Save New Password
                </button>

            </form>

        </div>

    </div>

</body>
</html>