@model PetWAMS.Web.Models.PetCategory

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>Add Category — PetHope Admin</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f8f5fb;
                color: #24142e;
            }

            .topbar {
                background: #241A3D;
                color: white;
                padding: 22px 45px;
                display: flex;
                justify-content: space-between;
            }

            .container {
                max-width: 700px;
                margin: 40px auto;
                padding: 0 25px;
            }

            .back {
                color: #7B2FF7;
                text-decoration: none;
                font-weight: bold;
            }

            h1 {
                margin: 25px 0;
            }

            .card {
                background: white;
                padding: 30px;
                border-radius: 18px;
                box-shadow: 0 8px 30px rgba(0,0,0,.06);
            }

            label {
                display: block;
                font-weight: bold;
                margin-bottom: 8px;
            }

            input {
                width: 100%;
                padding: 13px;
                border: 1px solid #ddd;
                border-radius: 10px;
                margin-bottom: 6px;
            }

            .error {
                color: #C34A5A;
                font-size: 13px;
                margin-bottom: 20px;
            }

            .btn {
                background: #7B2FF7;
                color: white;
                border: 0;
                padding: 13px 22px;
                border-radius: 10px;
                font-weight: bold;
                cursor: pointer;
            }
    </style>
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")


    <div class="topbar">
        <strong>🐾 PetHope Admin</strong>
        <span>Add Category</span>
    </div>

    <div class="container">

        <a href="/Admin/PetCategories"
           class="back">
            ← Back to Categories
        </a>

        <h1>Add Pet Category</h1>

        <div class="card">

            <form method="post"
                  action="/Admin/PetCategories/Create">

                @Html.AntiForgeryToken()

                <label>Category Name</label>

                <input type="text"
                       name="CategoryName"
                       value="@Model?.CategoryName"
                       placeholder="Example: Dog"
                       required />

                <div class="error">
                    @Html.ValidationMessageFor(m => m.CategoryName)
                </div>

                <button type="submit"
                        class="btn">
                    Create Category
                </button>

            </form>

        </div>

    </div>

</body>
</html>
