@model PetWAMS.Web.ViewModels.AdopterVerificationViewModel

@{
    Layout = null;
    ViewData["Title"] = "Identity Verification";

    string status = Model.CurrentStatus ?? string.Empty;

    bool isPending = status.Equals(
        "Pending",
        StringComparison.OrdinalIgnoreCase);

    bool isVerified = status.Equals(
        "Verified",
        StringComparison.OrdinalIgnoreCase);

    bool isRejected = status.Equals(
        "Rejected",
        StringComparison.OrdinalIgnoreCase);

    bool canSubmit =
        !Model.HasExistingVerification ||
        isRejected;

    bool hasSelectedPet =
        Model.PetID.HasValue &&
        !string.IsNullOrWhiteSpace(Model.SelectedPetName);

    string statusClass =
        isVerified
            ? "status-verified"
            : isRejected
                ? "status-rejected"
                : "status-pending";

    string statusTitle =
        isVerified
            ? "Identity Verified"
            : isRejected
                ? "Verification Rejected"
                : "Verification Under Review";

    string statusDescription;

    if (isVerified)
    {
        statusDescription = hasSelectedPet
            ? "Your identity has been verified. Your adoption request can now be reviewed by the administrator."
            : "Your identity has been verified. You can continue with the pet adoption process.";
    }
    else if (isRejected)
    {
        statusDescription =
            "Your previous submission was not approved. Review the administrator remarks and submit the corrected information.";
    }
    else
    {
        statusDescription = hasSelectedPet
            ? "Your identity verification and adoption request are waiting for administrator review."
            : "Your identity documents have been submitted and are waiting for administrator review.";
    }

    string successMessage =
        ViewBag.SuccessMessage?.ToString() ??
        string.Empty;
}

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Identity Verification - PetHope</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
          rel="stylesheet" />

    <style>
            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                min-height: 100%;
            }

            body {
                background: #faf8ff;
                color: #281d33;
                font-family: "DM Sans", Arial, sans-serif;
            }

            .topbar {
                min-height: 74px;
                background: #faf8ff;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                padding: 0 6%;
                border-bottom: 1px solid #eee5f7;
            }

            .brand {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                color: #30203d;
                text-decoration: none;
                font-family: "Fraunces", Georgia, serif;
                font-size: 25px;
                font-weight: 700;
            }

            .brand-mark {
                width: 42px;
                height: 42px;
                border-radius: 13px;
                background: linear-gradient( 135deg, #7c3aed, #a855f7 );
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-family: "DM Sans", Arial, sans-serif;
                font-size: 19px;
                box-shadow: 0 8px 20px rgba(124, 58, 237, 0.20);
            }

            .dashboard-link {
                color: #6b5a79;
                text-decoration: none;
                font-size: 14px;
                font-weight: 800;
                transition: 0.2s ease;
            }

                .dashboard-link:hover {
                    color: #7c3aed;
                }

            .page {
                padding: 48px 20px 72px;
            }

            .container {
                width: 100%;
                max-width: 980px;
                margin: 0 auto;
            }

            .hero-card,
            .selected-pet-card,
            .status-card,
            .form-card,
            .privacy-card {
                background: #ffffff;
                border: 1px solid #eee5f7;
                border-radius: 24px;
                box-shadow: 0 12px 40px rgba(70, 40, 100, 0.08);
            }

            .hero-card {
                padding: 42px;
                margin-bottom: 24px;
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                background: #f1e9ff;
                color: #7437cf;
                padding: 8px 14px;
                border-radius: 999px;
                font-size: 13px;
                font-weight: 800;
                margin-bottom: 18px;
            }

            .page-title {
                margin: 0;
                color: #2d1e39;
                font-family: "Fraunces", Georgia, serif;
                font-size: 40px;
                line-height: 1.16;
                font-weight: 600;
            }

            .page-description {
                max-width: 760px;
                margin: 15px 0 0;
                color: #776a82;
                font-size: 16px;
                line-height: 1.75;
            }

            .security-note {
                margin-top: 25px;
                padding: 16px 18px;
                background: #faf7ff;
                border: 1px solid #e7d9fa;
                border-radius: 15px;
                color: #675775;
                font-size: 14px;
                line-height: 1.65;
            }

            .success-message {
                margin-bottom: 24px;
                padding: 16px 18px;
                background: #ecfdf3;
                border: 1px solid #bbebcc;
                border-radius: 15px;
                color: #267547;
                font-size: 14px;
                font-weight: 700;
            }

            .selected-pet-card {
                margin-bottom: 24px;
                padding: 25px 30px;
                display: flex;
                align-items: center;
                gap: 18px;
                border-color: #dfcff7;
                background: linear-gradient( 135deg, #ffffff, #faf6ff );
            }

            .selected-pet-icon {
                width: 58px;
                height: 58px;
                border-radius: 18px;
                background: #efe4ff;
                color: #7637d0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex: 0 0 auto;
                font-size: 27px;
            }

            .selected-pet-content {
                min-width: 0;
            }

            .selected-pet-label {
                display: block;
                margin-bottom: 5px;
                color: #8a7997;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            .selected-pet-name {
                margin: 0;
                color: #34233f;
                font-family: "Fraunces", Georgia, serif;
                font-size: 24px;
                font-weight: 600;
            }

            .selected-pet-message {
                margin: 7px 0 0;
                color: #776783;
                font-size: 13px;
                line-height: 1.6;
            }

            .selected-pet-id {
                color: #7c3aed;
                font-weight: 800;
            }

            .status-card {
                padding: 30px 34px;
                margin-bottom: 24px;
            }

            .status-heading-row {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 20px;
            }

            .status-title {
                margin: 0;
                color: #2c2036;
                font-family: "Fraunces", Georgia, serif;
                font-size: 27px;
                font-weight: 600;
            }

            .status-description {
                margin: 9px 0 0;
                max-width: 680px;
                color: #786c81;
                font-size: 14px;
                line-height: 1.65;
            }

            .status-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 100px;
                padding: 9px 14px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 800;
            }

            .status-pending {
                background: #fff7dd;
                border: 1px solid #efd997;
                color: #8a6515;
            }

            .status-verified {
                background: #eafaf0;
                border: 1px solid #b9e7c9;
                color: #237547;
            }

            .status-rejected {
                background: #fff0f3;
                border: 1px solid #edc4cd;
                color: #a23f56;
            }

            .status-details {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px;
                margin-top: 24px;
            }

            .detail-box {
                background: #faf8fc;
                border: 1px solid #eee7f3;
                border-radius: 14px;
                padding: 15px 17px;
            }

            .detail-label {
                display: block;
                margin-bottom: 5px;
                color: #95899e;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 0.06em;
                text-transform: uppercase;
            }

            .detail-value {
                color: #44344f;
                font-size: 14px;
                font-weight: 700;
                word-break: break-word;
            }

            .admin-remarks {
                margin-top: 16px;
                padding: 16px 18px;
                background: #fff7f8;
                border: 1px solid #f0d1d7;
                border-radius: 14px;
            }

                .admin-remarks strong {
                    display: block;
                    margin-bottom: 6px;
                    color: #953d52;
                    font-size: 13px;
                }

                .admin-remarks p {
                    margin: 0;
                    color: #7d5a63;
                    font-size: 14px;
                    line-height: 1.6;
                }

            .form-card {
                padding: 38px 42px;
                margin-bottom: 24px;
            }

            .form-title {
                margin: 0;
                color: #2d1f38;
                font-family: "Fraunces", Georgia, serif;
                font-size: 29px;
                font-weight: 600;
            }

            .form-subtitle {
                margin: 9px 0 27px;
                color: #82758c;
                font-size: 14px;
                line-height: 1.65;
            }

            .validation-summary {
                margin-bottom: 22px;
                padding: 15px 18px;
                background: #fff1f4;
                border: 1px solid #efc7d0;
                border-radius: 14px;
                color: #a03e55;
                font-size: 14px;
            }

                .validation-summary:empty {
                    display: none;
                }

                .validation-summary ul {
                    margin: 0;
                    padding-left: 20px;
                }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 21px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

                .form-group.full-width {
                    grid-column: 1 / -1;
                }

            .form-label {
                color: #4b3b56;
                font-size: 13px;
                font-weight: 800;
            }

            .required-mark {
                color: #b6405c;
            }

            .form-control {
                width: 100%;
                min-height: 50px;
                padding: 12px 15px;
                background: #fefcff;
                border: 1px solid #ded3e8;
                border-radius: 13px;
                color: #2f2536;
                font-family: "DM Sans", Arial, sans-serif;
                font-size: 15px;
                outline: none;
                transition: border 0.2s ease, box-shadow 0.2s ease;
            }

                .form-control:focus {
                    border-color: #8b5cf6;
                    box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.11);
                }

            .file-control {
                padding: 11px 13px;
                cursor: pointer;
            }

            .field-note {
                color: #978b9f;
                font-size: 12px;
                line-height: 1.5;
            }

            .field-error {
                color: #b03f59;
                font-size: 12px;
                font-weight: 700;
            }

            .policy-box {
                margin-top: 27px;
                padding: 22px;
                background: #faf7ff;
                border: 1px solid #e7daf6;
                border-radius: 16px;
            }

            .policy-title {
                margin: 0 0 12px;
                color: #493657;
                font-size: 15px;
                font-weight: 800;
            }

            .policy-list {
                margin: 0;
                padding-left: 21px;
                color: #776980;
                font-size: 13px;
                line-height: 1.75;
            }

            .acceptance-row {
                display: flex;
                align-items: flex-start;
                gap: 11px;
                margin-top: 18px;
            }

            .acceptance-checkbox {
                width: 18px;
                height: 18px;
                margin-top: 2px;
                accent-color: #7c3aed;
                cursor: pointer;
                flex: 0 0 auto;
            }

            .acceptance-label {
                color: #4f4059;
                font-size: 13px;
                font-weight: 700;
                line-height: 1.55;
                cursor: pointer;
            }

            .submit-row {
                display: flex;
                align-items: center;
                gap: 13px;
                flex-wrap: wrap;
                margin-top: 27px;
            }

            .primary-button,
            .secondary-button {
                min-height: 49px;
                padding: 0 23px;
                border-radius: 13px;
                font-family: "DM Sans", Arial, sans-serif;
                font-size: 14px;
                font-weight: 800;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: 0.2s ease;
            }

            .primary-button {
                border: none;
                background: linear-gradient( 135deg, #7c3aed, #9333ea );
                color: #ffffff;
                box-shadow: 0 9px 23px rgba(124, 58, 237, 0.20);
            }

                .primary-button:hover {
                    background: linear-gradient( 135deg, #6d28d9, #7e22ce );
                    transform: translateY(-1px);
                }

            .secondary-button {
                border: 1px solid #ddd1e7;
                background: #ffffff;
                color: #62536d;
            }

                .secondary-button:hover {
                    border-color: #a782d2;
                    color: #7437cf;
                    background: #fcf9ff;
                }

            .privacy-card {
                padding: 27px 31px;
            }

            .privacy-title {
                margin: 0 0 9px;
                color: #392846;
                font-family: "Fraunces", Georgia, serif;
                font-size: 22px;
                font-weight: 600;
            }

            .privacy-text {
                margin: 0;
                color: #7c7085;
                font-size: 13px;
                line-height: 1.7;
            }

            @@media (max-width: 720px) {
                .topbar {
                    padding: 0 20px;
                }

                .dashboard-link {
                    font-size: 12px;
                }

                .page {
                    padding: 30px 14px 50px;
                }

                .hero-card,
                .form-card {
                    padding: 27px 22px;
                    border-radius: 19px;
                }

                .selected-pet-card,
                .status-card,
                .privacy-card {
                    padding: 24px 21px;
                    border-radius: 19px;
                }

                .selected-pet-card {
                    align-items: flex-start;
                }

                .page-title {
                    font-size: 31px;
                }

                .form-grid,
                .status-details {
                    grid-template-columns: 1fr;
                }

                .form-group.full-width {
                    grid-column: auto;
                }

                .status-heading-row {
                    flex-direction: column;
                }

                .primary-button,
                .secondary-button {
                    width: 100%;
                }
            }
    </style>
</head>

<body>
    <header class="topbar">
        <a asp-area="Adopter"
           asp-controller="Dashboard"
           asp-action="Index"
           class="brand">

            <span class="brand-mark">🐾</span>
            <span>PetHope</span>
        </a>

        <a asp-area="Adopter"
           asp-controller="Dashboard"
           asp-action="Index"
           class="dashboard-link">

            ← Back to Dashboard
        </a>
    </header>

    <main class="page">
        <div class="container">

            <section class="hero-card">
                <span class="eyebrow">
                    Adopter Safety
                </span>

                <h1 class="page-title">
                    Identity Verification
                </h1>

                <p class="page-description">
                    @if (hasSelectedPet)
                    {
                        <text>
                            Submit your NID information to apply for
                            @Model.SelectedPetName. Your adoption request
                            will automatically be created with a pending
                            status after submission.
                        </text>
                    }
                    else
                    {
                        <text>
                            Submit your NID information before applying
                            to adopt a pet. This verification helps protect
                            animals, shelters and responsible adopters.
                        </text>
                    }
                </p>

                <div class="security-note">
                    Your complete NID number is encrypted before
                    database storage. The system displays only the
                    last four digits after submission.
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="success-message">
                    @successMessage
                </div>
            }

            @if (hasSelectedPet)
            {
                <section class="selected-pet-card">
                    <div class="selected-pet-icon">
                        🐾
                    </div>

                    <div class="selected-pet-content">
                        <span class="selected-pet-label">
                            Selected Pet
                        </span>

                        <h2 class="selected-pet-name">
                            @Model.SelectedPetName
                        </h2>

                        <p class="selected-pet-message">
                            Pet ID:
                            <span class="selected-pet-id">
                                #@Model.PetID
                            </span>

                            · Submitting this verification will also
                            create a pending adoption request for this pet.
                        </p>
                    </div>
                </section>
            }

            @if (Model.HasExistingVerification)
            {
                <section class="status-card">
                    <div class="status-heading-row">
                        <div>
                            <h2 class="status-title">
                                @statusTitle
                            </h2>

                            <p class="status-description">
                                @statusDescription
                            </p>
                        </div>

                        <span class="status-badge @statusClass">
                            @status
                        </span>
                    </div>

                    <div class="status-details">
                        <div class="detail-box">
                            <span class="detail-label">
                                Name on NID
                            </span>

                            <span class="detail-value">
                                @Model.FullNameOnNID
                            </span>
                        </div>

                        <div class="detail-box">
                            <span class="detail-label">
                                NID Number
                            </span>

                            <span class="detail-value">
                                @Model.MaskedNID
                            </span>
                        </div>

                        <div class="detail-box">
                            <span class="detail-label">
                                Date of Birth
                            </span>

                            <span class="detail-value">
                                @(Model.DateOfBirth?.ToString(
                                    "dd MMMM yyyy"
                                ) ?? "Not available")
                            </span>
                        </div>

                        <div class="detail-box">
                            <span class="detail-label">
                                Submitted On
                            </span>

                            <span class="detail-value">
                                @(Model.SubmittedAt?.ToString(
                                    "dd MMMM yyyy, hh:mm tt"
                                ) ?? "Not available")
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.AdminRemarks))
                    {
                        <div class="admin-remarks">
                            <strong>
                                Admin Remarks
                            </strong>

                            <p>
                                @Model.AdminRemarks
                            </p>
                        </div>
                    }
                </section>
            }

            @if (canSubmit)
            {
                <section class="form-card">
                    <h2 class="form-title">
                        @(isRejected
                            ? "Resubmit Verification"
                            : "Submit Verification")
                    </h2>

                    <p class="form-subtitle">
                        Enter the information exactly as it appears
                        on your NID and upload clear document images.
                    </p>

                    <form asp-area="Adopter"
                          asp-controller="Verification"
                          asp-action="Index"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input asp-for="PetID"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary">
                        </div>

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label asp-for="FullNameOnNID"
                                       class="form-label">

                                    Full Name on NID
                                    <span class="required-mark">*</span>
                                </label>

                                <input asp-for="FullNameOnNID"
                                       class="form-control"
                                       autocomplete="name"
                                       placeholder="Enter the full name shown on your NID" />

                                <span asp-validation-for="FullNameOnNID"
                                      class="field-error">
                                </span>
                            </div>

                            <div class="form-group">
                                <label asp-for="DateOfBirth"
                                       class="form-label">

                                    Date of Birth
                                    <span class="required-mark">*</span>
                                </label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control"
                                       max="@DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd")" />

                                <span asp-validation-for="DateOfBirth"
                                      class="field-error">
                                </span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NIDNumber"
                                       class="form-label">

                                    NID Number
                                    <span class="required-mark">*</span>
                                </label>

                                <input asp-for="NIDNumber"
                                       type="text"
                                       class="form-control"
                                       inputmode="numeric"
                                       maxlength="17"
                                       autocomplete="off"
                                       placeholder="Enter 10, 13, or 17 digits" />

                                <span asp-validation-for="NIDNumber"
                                      class="field-error">
                                </span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NIDFrontImage"
                                       class="form-label">

                                    NID Front Image
                                    <span class="required-mark">*</span>
                                </label>

                                <input asp-for="NIDFrontImage"
                                       type="file"
                                       class="form-control file-control"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                                <span class="field-note">
                                    Upload a clear JPG, PNG or WEBP image.
                                    Maximum size: 5 MB.
                                </span>

                                <span asp-validation-for="NIDFrontImage"
                                      class="field-error">
                                </span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NIDBackImage"
                                       class="form-label">

                                    NID Back Image
                                </label>

                                <input asp-for="NIDBackImage"
                                       type="file"
                                       class="form-control file-control"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                                <span class="field-note">
                                    Optional. Maximum size: 5 MB.
                                </span>

                                <span asp-validation-for="NIDBackImage"
                                      class="field-error">
                                </span>
                            </div>
                        </div>

                        <div class="policy-box">
                            <h3 class="policy-title">
                                Pet Adoption Safety Policy
                            </h3>

                            <ul class="policy-list">
                                <li>
                                    I confirm that all submitted identity
                                    information is correct.
                                </li>

                                <li>
                                    I will provide safe housing, food,
                                    medical care and responsible treatment.
                                </li>

                                <li>
                                    I will not abuse, abandon, illegally
                                    sell or transfer an adopted pet.
                                </li>

                                <li>
                                    I agree to reasonable shelter
                                    follow-up after adoption.
                                </li>

                                <li>
                                    False documents or harmful activity
                                    may result in rejection or account
                                    restriction.
                                </li>
                            </ul>

                            <div class="acceptance-row">
                                <input asp-for="PolicyAccepted"
                                       type="checkbox"
                                       class="acceptance-checkbox" />

                                <label asp-for="PolicyAccepted"
                                       class="acceptance-label">

                                    I have read and accept the Pet
                                    Adoption Safety Policy.
                                </label>
                            </div>

                            <span asp-validation-for="PolicyAccepted"
                                  class="field-error">
                            </span>
                        </div>

                        <div class="submit-row">
                            <button type="submit"
                                    class="primary-button">

                                @if (hasSelectedPet)
                                {
                                    if (isRejected)
                                    {
                                        <text>
                                            Resubmit Verification &amp;
                                            Adoption Request
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            Submit Verification &amp;
                                            Adoption Request
                                        </text>
                                    }
                                }
                                else
                                {
                                    if (isRejected)
                                    {
                                        <text>
                                            Resubmit for Review
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            Submit for Review
                                        </text>
                                    }
                                }
                            </button>

                            <a asp-area="Adopter"
                               asp-controller="Dashboard"
                               asp-action="Index"
                               class="secondary-button">

                                Cancel
                            </a>
                        </div>
                    </form>
                </section>
            }

            <section class="privacy-card">
                <h2 class="privacy-title">
                    Privacy and document protection
                </h2>

                <p class="privacy-text">
                    Uploaded NID images are stored outside the public
                    website folder. Only authorized administrators can
                    review them. Your complete NID number will not be
                    displayed on the adopter dashboard.
                </p>
            </section>
        </div>
    </main>
</body>

</html>