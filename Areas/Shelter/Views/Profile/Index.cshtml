@model PetWAMS.Web.Models.Shelter

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Shelter Profile — PetHope</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: #f8f5fb;
                color: #24142e;
                font-family: 'DM Sans', Arial, sans-serif;
            }

            a {
                text-decoration: none;
            }

            .site-navbar {
                width: 100%;
                height: 76px;
                background: #f8f5fb;
                border-bottom: none;
                box-shadow: none;
                display: flex;
                align-items: center;
                padding: 0 60px;
            }

            .site-logo {
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: 'Fraunces', Georgia, serif;
                font-weight: 800;
                font-size: 26px;
                color: #7B2FF7;
            }

            .site-logo-mark {
                width: 36px;
                height: 36px;
                border-radius: 11px;
                background: linear-gradient(135deg, #7B2FF7, #B383F5);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                color: white;
            }

            .container {
                max-width: 900px;
                margin: 45px auto;
                padding: 0 25px;
            }

            .back {
                color: #7131e8;
                text-decoration: none;
                font-weight: 800;
                display: inline-block;
                margin-bottom: 25px;
            }

            .card {
                background: white;
                padding: 35px;
                border-radius: 20px;
                box-shadow: 0 8px 25px rgba(0,0,0,.06);
            }

            .profile-top {
                display: flex;
                align-items: center;
                gap: 20px;
                margin-bottom: 30px;
            }

            .avatar {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                background: #f5c75d;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 30px;
                font-weight: 800;
                color: #24142e;
            }

            .profile-top h1 {
                margin-bottom: 5px;
                font-size: 32px;
                font-weight: 800;
            }

            .profile-top p {
                color: #777;
                font-size: 16px;
            }

            .info {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }

            .box {
                background: #faf8fd;
                padding: 18px;
                border-radius: 12px;
            }

            .label {
                font-size: 13px;
                color: #777;
                margin-bottom: 7px;
            }

            .value {
                font-weight: 800;
            }

            .edit-btn {
                display: inline-block;
                margin-top: 30px;
                background: #7131e8;
                color: white;
                padding: 13px 25px;
                border-radius: 10px;
                text-decoration: none;
                font-weight: 800;
            }

                .edit-btn:hover {
                    background: #5A1FB8;
                    color: white;
                }

            @@media (max-width: 700px) {
                .site-navbar {
                    height: 70px;
                    padding: 0 24px;
                }

                .site-logo {
                    font-size: 22px;
                }

                .info {
                    grid-template-columns: 1fr;
                }

                .profile-top {
                    align-items: flex-start;
                }
            }
    </style>
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")


    <nav class="site-navbar">
        <a href="/" class="site-logo">
            <span class="site-logo-mark">🐾</span>
            <span>PetHope</span>
        </a>
    </nav>

    <div class="container">

        @if (Model == null)
        {
            <div class="card">
                <p>No shelter record found.</p>
            </div>
        }
        else
        {
            <div class="card">

                <div class="profile-top">
                    <div class="avatar">
                        HP
                    </div>

                    <div>
                        <h1>@Model.ShelterName</h1>
                        <p>Shelter / Staff</p>
                    </div>
                </div>

                <div class="info">

                    <div class="box">
                        <div class="label">Shelter Name</div>
                        <div class="value">@Model.ShelterName</div>
                    </div>

                    <div class="box">
                        <div class="label">Email</div>
                        <div class="value">
                            @(string.IsNullOrWhiteSpace(Model.Email) ? "Not set" : Model.Email)
                        </div>
                    </div>

                    <div class="box">
                        <div class="label">Phone</div>
                        <div class="value">@Model.ContactNumber</div>
                    </div>

                    <div class="box">
                        <div class="label">Location</div>
                        <div class="value">@Model.Address</div>
                    </div>

                    <div class="box">
                        <div class="label">Total Pets</div>
                        <div class="value">@ViewBag.TotalPets</div>
                    </div>

                    <div class="box">
                        <div class="label">Total Adoptions</div>
                        <div class="value">@ViewBag.TotalAdoptions</div>
                    </div>

                </div>

                <a href="#" class="edit-btn">
                    Edit Profile
                </a>

            </div>
        }

    </div>

</body>
</html>