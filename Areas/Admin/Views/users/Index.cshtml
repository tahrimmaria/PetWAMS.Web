@model List<PetWAMS.Web.Models.User>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Manage Users — PetHope</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --purple: #7B2FF7;
                --purple-dark: #5A1FB8;
                --bg: #f8f5fb;
                --text: #24142e;
                --muted: #756a7c;
                --card: #ffffff;
                --line: #eee7f4;
                --green-bg: #E7F8EC;
                --green: #258447;
                --yellow-bg: #FFF4D9;
                --yellow: #A46B00;
                --red-bg: #FDE7EA;
                --red: #C23E52;
                --blue-bg: #E9F3FF;
                --blue: #2767A5;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: 'DM Sans', Arial, sans-serif;
                min-height: 100vh;
            }

            a {
                text-decoration: none;
            }

            .page-container {
                width: calc(100% - 120px);
                max-width: 1500px;
                margin: 42px auto 90px auto;
            }

            .back {
                display: inline-block;
                color: var(--purple);
                font-size: 16px;
                font-weight: 800;
                margin-bottom: 26px;
            }

                .back:hover {
                    color: var(--purple-dark);
                }

            .heading-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                margin-bottom: 28px;
            }

            h1 {
                font-family: 'DM Sans', Arial, sans-serif;
                font-size: 34px;
                line-height: 1.2;
                font-weight: 800;
                color: var(--text);
            }

            .add-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: 50px;
                padding: 0 24px;
                border-radius: 10px;
                background: var(--purple);
                color: #ffffff;
                font-size: 16px;
                font-weight: 800;
                white-space: nowrap;
            }

                .add-btn:hover {
                    background: var(--purple-dark);
                    color: #ffffff;
                }

            .alert-success {
                background: #EAF8EF;
                color: #267A46;
                border: 1px solid #BEE5CB;
                padding: 14px 18px;
                border-radius: 12px;
                margin-bottom: 20px;
                font-weight: 800;
            }

            .alert-error {
                background: #FDEBE7;
                color: #B63E4D;
                border: 1px solid #F4C7CD;
                padding: 14px 18px;
                border-radius: 12px;
                margin-bottom: 20px;
                font-weight: 800;
            }

            .table-card {
                width: 100%;
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: 18px;
                overflow-x: auto;
                overflow-y: hidden;
                box-shadow: 0 8px 30px rgba(36, 20, 46, .05);
            }

            table {
                width: 100%;
                min-width: 1380px;
                border-collapse: collapse;
            }

            th {
                background: #F3EDFB;
                color: var(--text);
                text-align: left;
                padding: 16px;
                font-size: 14px;
                font-weight: 800;
                white-space: nowrap;
            }

            td {
                padding: 16px;
                border-top: 1px solid #eeeeee;
                font-size: 14px;
                vertical-align: middle;
                color: #15051f;
            }

            .id-col {
                width: 70px;
            }

            .name-col {
                min-width: 140px;
            }

            .email-col {
                min-width: 170px;
            }

            .phone-col {
                min-width: 130px;
            }

            .address-col {
                min-width: 130px;
            }

            .role-col {
                min-width: 110px;
            }

            .shelter-col {
                min-width: 175px;
            }

            .status-col {
                min-width: 150px;
            }

            .action-col {
                min-width: 330px;
                width: 330px;
            }

            .role {
                display: inline-block;
                background: #F2E9FE;
                color: var(--purple);
                padding: 7px 13px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 800;
                white-space: nowrap;
            }

            .shelter {
                display: inline-block;
                background: var(--blue-bg);
                color: var(--blue);
                padding: 7px 13px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 800;
                white-space: nowrap;
            }

            .none {
                color: #999;
                font-weight: 700;
            }

            .status {
                display: inline-block;
                padding: 7px 13px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 800;
                white-space: nowrap;
            }

            .status-approved {
                background: var(--green-bg);
                color: var(--green);
            }

            .status-pending {
                background: var(--yellow-bg);
                color: var(--yellow);
            }

            .status-rejected {
                background: var(--red-bg);
                color: var(--red);
            }

            .action-wrap {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
            }

                .action-wrap form {
                    margin: 0;
                    padding: 0;
                    display: inline-flex;
                }

            .reset-btn,
            .edit-btn,
            .delete-btn,
            .approve-btn,
            .reject-btn {
                min-height: 34px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 9px;
                padding: 0 12px;
                border: none;
                font-family: 'DM Sans', Arial, sans-serif;
                font-size: 14px;
                font-weight: 800;
                cursor: pointer;
                white-space: nowrap;
            }

            .reset-btn {
                background: var(--blue-bg);
                color: var(--blue);
            }

            .edit-btn {
                background: transparent;
                color: var(--purple);
                padding-left: 4px;
                padding-right: 4px;
            }

            .delete-btn {
                background: #FDEBE7;
                color: #C34A5A;
            }

            .approve-btn {
                background: #E5F7EB;
                color: #237A42;
            }

            .reject-btn {
                background: #FFF0E0;
                color: #B86417;
            }

            .empty {
                text-align: center;
                padding: 34px;
                color: var(--muted);
                font-weight: 700;
            }

            @@media (max-width: 900px) {
                .page-container {
                    width: calc(100% - 40px);
                    margin-top: 34px;
                }

                .heading-row {
                    flex-direction: column;
                    align-items: flex-start;
                }

                h1 {
                    font-size: 28px;
                }
            }
    </style>
</head>

<body>

    @await Html.PartialAsync("~/Views/Shared/Navbar.cshtml")

    <div class="page-container">

        <div class="heading-row">
            <h1>Manage Users</h1>

            <a href="/Admin/Users/Create" class="add-btn">
                + Add User
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-error">
                @TempData["Error"]
            </div>
        }

        <div class="table-card">
            <table>
                <thead>
                    <tr>
                        <th class="id-col">ID</th>
                        <th class="name-col">Full Name</th>
                        <th class="email-col">Email</th>
                        <th class="phone-col">Phone</th>
                        <th class="address-col">Address</th>
                        <th class="role-col">User Type</th>
                        <th class="shelter-col">Assigned Shelter</th>
                        <th class="status-col">Approval Status</th>
                        <th class="action-col">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="empty">
                                No users found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="id-col">
                                    #@user.UserID
                                </td>

                                <td class="name-col">
                                    @user.FullName
                                </td>

                                <td class="email-col">
                                    @user.Email
                                </td>

                                <td class="phone-col">
                                    @user.Phone
                                </td>

                                <td class="address-col">
                                    @user.Address
                                </td>

                                <td class="role-col">
                                    <span class="role">
                                        @user.UserType
                                    </span>
                                </td>

                                <td class="shelter-col">
                                    @if (user.UserType == "Staff" && user.Shelter != null)
                                    {
                                        <span class="shelter">
                                            @user.Shelter.ShelterName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="none">
                                            —
                                        </span>
                                    }
                                </td>

                                <td class="status-col">
                                    @if (user.ApprovalStatus == "Pending")
                                    {
                                        <span class="status status-pending">
                                            Pending
                                        </span>
                                    }
                                    else if (user.ApprovalStatus == "Rejected")
                                    {
                                        <span class="status status-rejected">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status status-approved">
                                            Approved
                                        </span>
                                    }
                                </td>

                                <td class="action-col">
                                    <div class="action-wrap">

                                        @if (user.UserType == "Staff" && user.ApprovalStatus == "Pending")
                                        {
                                            <form method="post" action="/Admin/Users/Approve/@user.UserID">
                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="approve-btn">
                                                    Approve
                                                </button>
                                            </form>

                                            <form method="post" action="/Admin/Users/Reject/@user.UserID">
                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="reject-btn">
                                                    Reject
                                                </button>
                                            </form>
                                        }

                                        @if (user.UserType == "Staff" && user.ApprovalStatus == "Rejected")
                                        {
                                            <form method="post" action="/Admin/Users/Approve/@user.UserID">
                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="approve-btn">
                                                    Approve
                                                </button>
                                            </form>
                                        }

                                        @if (user.UserType != "Admin")
                                        {
                                            <a href="/Admin/Users/ResetPassword/@user.UserID" class="reset-btn">
                                                Reset Password
                                            </a>
                                        }

                                        <a href="/Admin/Users/Edit/@user.UserID" class="edit-btn">
                                            Edit
                                        </a>

                                        <form method="post"
                                              action="/Admin/Users/Delete/@user.UserID"
                                              onsubmit="return confirm('Are you sure you want to delete this user?');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="delete-btn">
                                                Delete
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>

</body>
</html>